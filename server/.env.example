# 로컬 개발용 예시. 실제 값은 .env 에 넣고 커밋하지 않는다.
ACCESS_CODE=change-me
UPSTAGE_API_KEY=
GEMINI_API_KEY=
PRIMARY_PROVIDER=upstage
FALLBACK_PROVIDER=gemini
# 아래는 선택 (기본값은 코드 참고). 모델명·엔드포인트는 최신 공식 문서에 맞춰 조정
# UPSTAGE_SOLAR_MODEL=solar-pro2
# UPSTAGE_PARSE_MODEL=document-parse
# GEMINI_MODEL=gemini-2.5-flash
# PROVIDER_TIMEOUT_MS=20000
# DAILY_CALL_LIMIT=200
# RATE_LIMIT_PER_MIN=10
# 배포된 웹 출처 (로컬 개발은 vite 프록시를 쓰므로 불필요)
# ALLOWED_ORIGIN=https://junghwan12.github.io
